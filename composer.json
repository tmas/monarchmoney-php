{
    "name": "tmas/monarchmoney-php",
    "description": "A PHP library for interacting with the Monarch Money API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmas",
            "email": "composer@lord.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MonarchMoney\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonarchMoney\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
